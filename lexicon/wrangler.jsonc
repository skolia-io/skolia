// skolia-lexicon: the lexicon's public API (src/app.ts) and the RPC the API's cards use
// (LexiconService, src/main.ts). Deployed with wrangler (just deploy-lexicon). Terraform
// (infra/) makes each language's D1 database, wrangler applies migrations/, and
// infra/load-lexicon.py loads a build into it. The top level is production and wrangler
// dev; staging is env.staging; a preview's config is made from staging's (infra/preview.py).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "skolia-lexicon",
  "main": "src/main.ts",
  "compatibility_date": "2026-10-19",
  "minify": true,
  // Its own hostname, below; a preview has none, and is read through its skolia Worker's
  // /api/lexicon/
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  // Runs near D1 when that's faster than near the caller. Inherited by env.staging and previews.
  "placement": { "mode": "smart" },
  "routes": [{ "pattern": "lexicon.skolia.io", "custom_domain": true }],
  "d1_databases": [
    { "binding": "LEXICON_EN", "database_name": "skolia-lexicon-en", "migrations_dir": "migrations" },
    { "binding": "LEXICON_FR", "database_name": "skolia-lexicon-fr", "migrations_dir": "migrations" },
    { "binding": "LEXICON_PL", "database_name": "skolia-lexicon-pl", "migrations_dir": "migrations" }
  ],
  // Bindings and routes aren't inherited. Deployed as skolia-lexicon-staging.
  "env": {
    "staging": {
      "routes": [{ "pattern": "lexicon-staging.skolia.io", "custom_domain": true }],
      "d1_databases": [
        { "binding": "LEXICON_EN", "database_name": "skolia-lexicon-en-staging", "migrations_dir": "migrations" },
        { "binding": "LEXICON_FR", "database_name": "skolia-lexicon-fr-staging", "migrations_dir": "migrations" },
        { "binding": "LEXICON_PL", "database_name": "skolia-lexicon-pl-staging", "migrations_dir": "migrations" }
      ]
    }
  }
}
