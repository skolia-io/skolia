{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error"
  },
  "ignorePatterns": ["lib/ts/schema.gen.ts", "lib/ts/schema.zod.gen.ts"],
  "rules": {
    "eslint/no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_"
      }
    ],
    "eslint/complexity": [
      "error",
      {
        "max": 20,
        "variant": "modified"
      }
    ]
  }
}
