// skolia-oauth-proxy: the previews' Google sign-in (src/handler.ts). One for all previews,
// deployed from main (just deploy-oauth-proxy); its secrets are the oauth-proxy GitHub
// environment's. infra/preview.py gives previews its URL.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "skolia-oauth-proxy",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-19",
  "minify": true,
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true, "traces": { "enabled": true }, "issues": { "enabled": true } },
  // Only production's; deployed with --env so its traces are tagged deployment.environment.name.
  // Routes and vars aren't inherited.
  "env": {
    "production": {
      "name": "skolia-oauth-proxy",
      "routes": [{ "pattern": "oauth-proxy.skolia.io", "custom_domain": true }],
      "vars": {
        "BASE_URL": "https://oauth-proxy.skolia.io",
        // The previews' origins (infra/preview.py), the only ones it redirects to
        "PREVIEWS": "^https://skolia-pr-[0-9]+\\.skolia-io\\.workers\\.dev$"
      }
    }
  }
}
