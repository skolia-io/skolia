# For wrangler dev (just dev), which loads it for both Workers. Not secrets.
SLEEP_AFTER=30s
# The reader's Vite server, in place of wrangler.jsonc's https://skolia.io (sign-in redirects)
BASE_URL=http://localhost:5173
# Signs local sessions only. Deployed, each environment has its own (Terraform's better_auth_secret).
BETTER_AUTH_SECRET=skolia-dev-only-secret-not-used-anywhere-deployed
# The user Durable Object's migrations only (api/src/user/migrations, not D1's): an edited last one is reverted with the
# down it was applied with and applied again, as on previews
MUTABLE_FINAL_USER_MIGRATION=true
