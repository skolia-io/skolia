{
  "name": "@skolia/api",
  "private": true,
  "type": "module",
  "exports": {
    "./app": "./src/app.ts"
  },
  "scripts": {
    "check": "tsc --noEmit && tsc --noEmit -p src/worker && tsc --noEmit -p tsconfig.workerd-test.json",
    "pretest": "pnpm --filter @skolia/reader build && wrangler deploy --dry-run --outdir dist --env=''",
    "test": "node --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@better-auth/api-key": "1.7.12",
    "@hono/standard-validator": "0.4.1",
    "@logtape/logtape": "2.4.2",
    "@skolia/ingest": "workspace:*",
    "@skolia/lexicon": "workspace:*",
    "@skolia/shared": "workspace:*",
    "@skolia/util": "workspace:*",
    "better-auth": "catalog:",
    "hono": "4.13.16",
    "ts-fsrs": "6.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261104.1",
    "@skolia/oauth-proxy": "workspace:*",
    "@standard-schema/spec": "1.1.0",
    "@types/node": "26.6.5",
    "hono-openapi": "1.5.0",
    "openapi-types": "12.1.3",
    "typescript": "7.0.2",
    "wrangler": "4.158.0",
    "yaml": "2.9.1"
  }
}
