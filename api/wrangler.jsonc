// skolia on Cloudflare: one Worker serves the reader (static assets) and the API.
// Deployed with wrangler (infra/wrangler.sh <env> deploy), which also applies the
// Durable Object migrations. Terraform (infra/) makes the D1 database, R2 bucket and
// queue it binds. The top level is what every environment shares; each "env" block has
// what's its own. Ingest is a separate Worker: ingest/wrangler.jsonc.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "skolia",
  "main": "src/worker/main.ts",
  "compatibility_date": "2026-10-19",
  "minify": true,
  "workers_dev": true,
  "preview_urls": false,
  // Workers Logs, traces and Issues; log events are src/log.ts's
  "observability": { "enabled": true, "traces": { "enabled": true }, "issues": { "enabled": true } },
  // Deploys after all status publishers: backfills never race an old publisher.
  "triggers": { "crons": ["* * * * *"] },
  // Runs /api/* near D1 and R2 when that's faster than near the user; assets are still
  // served from the nearest location.
  "placement": { "mode": "smart" },
  // wrangler dev would otherwise rewrite each request's Host to the route's, and the
  // ingest container's S3 requests, signed for localhost:8787, would fail
  "dev": { "host": "localhost:8787" },
  "assets": {
    "directory": "../reader/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["User"] }],
  // Bindings, routes and vars aren't inherited, so each environment lists its own
  // (Terraform's names), and its name, which wrangler would otherwise suffix with the
  // environment's. Wrangler looks D1 databases up by name, and creates one it can't find,
  // so Terraform must make it first (just deploy-infra). Deployed with --env, so traces are
  // tagged deployment.environment.name; dev is wrangler dev's and the tests'. A preview's
  // config is staging's with its own names (infra/preview.py).
  //
  // DB, BLOBS: the documents. LEXICON: the lexicon Worker (lexicon-api/wrangler.jsonc), whose
  // LexiconService the cards use and whose API is passed through at /api/lexicon/.
  // INGEST_WORKFLOW: the ingest Worker's runs of ingest (ingest/wrangler.jsonc), one
  // started for each document to analyse. INGESTER: the ingest Worker's, asked where a
  // document is in its container's line. Deployed, the auth secrets are wrangler secrets;
  // wrangler dev takes them from api/.env.local (DEVELOP.md). READER_LEXICON_CONCURRENCY:
  // how many lexicon entries the reader fetches at once (api/src/reader-config.ts; unset,
  // as in dev, it's 6); changing it is a deploy (infra/README.md). IMPORT_RATE_LIMIT,
  // IMPORT_RATE_WINDOW_SECONDS: how many texts a user may import in how many seconds, unless
  // one of their roles grants unlimited-rate (api/src/rate-limits.ts; unset, 20 an hour).
  "env": {
    "dev": {
      "name": "skolia",
      "d1_databases": [{ "binding": "DB", "database_name": "skolia", "migrations_dir": "migrations" }],
      "services": [{ "binding": "LEXICON", "service": "skolia-lexicon", "entrypoint": "LexiconService" }],
      "r2_buckets": [{ "binding": "BLOBS", "bucket_name": "skolia-documents" }],
      // The reader's Vite server (sign-in redirects)
      "vars": { "BASE_URL": "http://localhost:5173" },
      "workflows": [
        { "name": "skolia-ingest", "binding": "INGEST_WORKFLOW", "class_name": "IngestWorkflow", "script_name": "skolia-ingest" }
      ],
      "durable_objects": {
        "bindings": [
          { "name": "USER", "class_name": "User" },
          { "name": "INGESTER", "class_name": "Ingester", "script_name": "skolia-ingest" }
        ]
      }
    },
    "production": {
      "name": "skolia",
      "routes": [{ "pattern": "skolia.io", "custom_domain": true }],
      "d1_databases": [{ "binding": "DB", "database_name": "skolia", "migrations_dir": "migrations" }],
      "services": [{ "binding": "LEXICON", "service": "skolia-lexicon", "entrypoint": "LexiconService" }],
      "r2_buckets": [{ "binding": "BLOBS", "bucket_name": "skolia-documents" }],
      "vars": {
        "BASE_URL": "https://skolia.io",
        "READER_LEXICON_CONCURRENCY": "6",
        "IMPORT_RATE_LIMIT": "20",
        "IMPORT_RATE_WINDOW_SECONDS": "3600"
      },
      "workflows": [
        { "name": "skolia-ingest", "binding": "INGEST_WORKFLOW", "class_name": "IngestWorkflow", "script_name": "skolia-ingest" }
      ],
      "durable_objects": {
        "bindings": [
          { "name": "USER", "class_name": "User" },
          { "name": "INGESTER", "class_name": "Ingester", "script_name": "skolia-ingest" }
        ]
      }
    },
    "staging": {
      "name": "skolia-staging",
      "routes": [{ "pattern": "staging.skolia.io", "custom_domain": true }],
      "d1_databases": [{ "binding": "DB", "database_name": "skolia-staging", "migrations_dir": "migrations" }],
      "services": [{ "binding": "LEXICON", "service": "skolia-lexicon-staging", "entrypoint": "LexiconService" }],
      "r2_buckets": [{ "binding": "BLOBS", "bucket_name": "skolia-documents-staging" }],
      "vars": {
        "BASE_URL": "https://staging.skolia.io",
        "READER_LEXICON_CONCURRENCY": "6",
        "IMPORT_RATE_LIMIT": "20",
        "IMPORT_RATE_WINDOW_SECONDS": "3600"
      },
      "workflows": [
        {
          "name": "skolia-ingest-staging",
          "binding": "INGEST_WORKFLOW",
          "class_name": "IngestWorkflow",
          "script_name": "skolia-ingest-staging"
        }
      ],
      "durable_objects": {
        "bindings": [
          { "name": "USER", "class_name": "User" },
          { "name": "INGESTER", "class_name": "Ingester", "script_name": "skolia-ingest-staging" }
        ]
      }
    }
  }
}
