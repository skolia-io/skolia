// skolia on Cloudflare: one Worker serves the reader (static assets) and the API.
// Deployed with wrangler (infra/wrangler.sh <env> deploy), which also applies the
// Durable Object migrations. Terraform (infra/) makes the D1 database, R2 bucket and
// queue it binds. The top level is production and wrangler dev; staging is env.staging.
// Ingest is a separate Worker: ingest/wrangler.jsonc.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "skolia",
  "main": "src/worker/main.ts",
  "compatibility_date": "2026-10-19",
  "minify": true,
  "workers_dev": true,
  "preview_urls": false,
  // Workers Logs, inherited by env.staging and previews; log events are src/log.ts's
  "observability": { "enabled": true },
  // Deploys after all status publishers: backfills never race an old publisher.
  "triggers": { "crons": ["* * * * *"] },
  // Runs /api/* near D1 and R2 when that's faster than near the user; assets are still
  // served from the nearest location. Inherited by env.staging and previews.
  "placement": { "mode": "smart" },
  "routes": [{ "pattern": "skolia.io", "custom_domain": true }],
  // wrangler dev would otherwise rewrite each request's Host to the route's, and the
  // ingest container's S3 requests, signed for localhost:8787, would fail
  "dev": { "host": "localhost:8787" },
  "assets": {
    "directory": "../reader/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "skolia",
      "migrations_dir": "migrations"
    },
    {
      "binding": "LEXICON_EN",
      "database_name": "skolia-lexicon-en",
      "migrations_dir": "lexicon-migrations"
    },
    {
      "binding": "LEXICON_FR",
      "database_name": "skolia-lexicon-fr",
      "migrations_dir": "lexicon-migrations"
    },
    {
      "binding": "LEXICON_PL",
      "database_name": "skolia-lexicon-pl",
      "migrations_dir": "lexicon-migrations"
    }
  ],
  "r2_buckets": [{ "binding": "BLOBS", "bucket_name": "skolia-documents" }],
  // wrangler dev takes BASE_URL from api/.env, and the auth secrets from api/.env.local (DEVELOP.md); deployed, they're wrangler secrets.
  "vars": { "BASE_URL": "https://skolia.io" },
  // INGEST_WORKFLOW: the ingest Worker's runs of ingest (ingest/wrangler.jsonc), one started
  // for each document to analyse
  "workflows": [{ "name": "skolia-ingest", "binding": "INGEST_WORKFLOW", "class_name": "IngestWorkflow", "script_name": "skolia-ingest" }],
  // INGESTER: the ingest Worker's, asked where a document is in its container's line
  "durable_objects": {
    "bindings": [{ "name": "USER", "class_name": "User" }, { "name": "INGESTER", "class_name": "Ingester", "script_name": "skolia-ingest" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["User"] }],
  // Bindings and routes aren't inherited, so each environment lists its own (Terraform's
  // names). Wrangler looks D1 databases up by name, and creates one it can't find, so
  // Terraform must make it first (just deploy-infra). Deployed as skolia-staging.
  "env": {
    "staging": {
      "triggers": { "crons": ["* * * * *"] },
      "routes": [{ "pattern": "staging.skolia.io", "custom_domain": true }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "skolia-staging",
          "migrations_dir": "migrations"
        },
        {
          "binding": "LEXICON_EN",
          "database_name": "skolia-lexicon-en-staging",
          "migrations_dir": "lexicon-migrations"
        },
        {
          "binding": "LEXICON_FR",
          "database_name": "skolia-lexicon-fr-staging",
          "migrations_dir": "lexicon-migrations"
        },
        {
          "binding": "LEXICON_PL",
          "database_name": "skolia-lexicon-pl-staging",
          "migrations_dir": "lexicon-migrations"
        }
      ],
      "r2_buckets": [{ "binding": "BLOBS", "bucket_name": "skolia-documents-staging" }],
      "vars": { "BASE_URL": "https://staging.skolia.io" },
      "workflows": [
        {
          "name": "skolia-ingest-staging",
          "binding": "INGEST_WORKFLOW",
          "class_name": "IngestWorkflow",
          "script_name": "skolia-ingest-staging"
        }
      ],
      "durable_objects": {
        "bindings": [
          { "name": "USER", "class_name": "User" },
          { "name": "INGESTER", "class_name": "Ingester", "script_name": "skolia-ingest-staging" }
        ]
      }
    }
  }
}
