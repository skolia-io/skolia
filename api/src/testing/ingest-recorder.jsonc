// Test-only stand-in for the ingest Worker: has the Ingester class and the workflow the API's
// INGESTER and INGEST_WORKFLOW bindings name
{
  "name": "skolia-ingest",
  "main": "ingest-recorder.ts",
  "compatibility_date": "2026-10-19",
  "d1_databases": [{ "binding": "INGEST_DB", "database_name": "skolia-ingest", "migrations_dir": "../../../ingest/migrations" }],
  "services": [{ "binding": "DOCUMENT_STATUS", "service": "skolia", "entrypoint": "DocumentStatus" }],
  "workflows": [{ "name": "skolia-ingest", "binding": "INGEST_WORKFLOW", "class_name": "IngestWorkflow" }],
  "durable_objects": {
    "bindings": [{ "name": "INGESTER", "class_name": "Ingester" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Ingester"] }]
}
